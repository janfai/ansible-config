# /etc/default/rkhunter spravováno Ansiblem — žádné denní "vše v pořádku" zprávy,
# pouze e-mail při skutečném pozitivním nálezu (standardní cron skript balíčku
# s --report-warnings-only už sám nic nepošle, když je výstup prázdný).
CRON_DAILY_RUN="true"
CRON_DB_UPDATE="true"
APT_AUTOGEN="true"
NICE="10"
RUN_CHECK_ON_BATTERY="false"
REPORT_EMAIL="root"
