[Unit]
Description=Upgrade Guardian rescue channel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/upgrade-guardian/guardian
Restart=always
RestartSec=30
User=root
Group=root
WorkingDirectory=/var/lib/upgrade-guardian
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/var/lib/upgrade-guardian/agent-home/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=false
ReadWritePaths=/etc/upgrade-guardian /var/lib/upgrade-guardian /opt/upgrade-guardian

[Install]
WantedBy=multi-user.target
