def upgrade_diagnostics():
    apt = {}
    for name, argv in (("dpkg_audit", ["dpkg", "--audit"]), ("apt_locks", ["fuser", "/var/lib/dpkg/lock", "/var/lib/dpkg/lock-frontend", "/var/lib/apt/lists/lock", "/var/cache/apt/archives/lock"]), ("apt_fix_dry_run", ["apt-get", "-s", "-f", "install"])):
        code, output = run(argv, timeout=15)
        apt[name] = {"exit_code": code, "output": trim(output)}
    snapshots = {}
    for name, argv in (("timeshift", ["timeshift", "--list"]), ("btrfs", ["btrfs", "subvolume", "list", "/"]), ("zfs", ["zfs", "list", "-t", "snapshot", "-o", "name,creation"])):
        code, output = run(argv, timeout=10)
        snapshots[name] = {"available": code == 0, "output": trim(output)}
    extra = {}
    for key, argv in (("df_root", ["df", "-h", "/"]), ("df_boot", ["df", "-h", "/boot"]), ("df_home", ["df", "-h", "/home"]), ("inodes", ["df", "-i", "/", "/boot", "/home"]), ("power", ["sh", "-c", "for p in /sys/class/power_supply/*; do [ -e \"$p/online\" ] && printf '%s online=' \"$p\" && cat \"$p/online\"; [ -e \"$p/status\" ] && printf '%s status=' \"$p\" && cat \"$p/status\"; done"])):
        code, output = run(argv, timeout=10)
        extra[key] = {"exit_code": code, "output": trim(output)}
    return {"apt_dpkg": apt, "snapshots": snapshots, "system": extra, "apt_log": lines(Path("/var/log/apt/term.log"), 100), "dpkg_log": lines(Path("/var/log/dpkg.log"), 100)}


def execute_upgrade(task, task_id="upgrade"):
    steps = task.get("steps")
    if not isinstance(steps, list) or not steps:
        return "rejected", {"error": "upgrade vyžaduje neprázdný seznam steps"}
    state_path = VAR / "upgrade-state" / (str(task_id) + ".json")
    prior = None
    try:
        prior = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        pass
    if prior and prior.get("status") == "running":
        diagnostics = upgrade_diagnostics()
        repair = {"exit_code": None, "output": "not allowed by task"}
        if task.get("allow_dpkg_configure") is True:
            code, output = run(["dpkg", "--configure", "-a"], timeout=3600)
            repair = {"exit_code": code, "output": trim(output)}
        prior["status"] = "blocked_waiting_instructions"
        prior["recovery_diagnostics"] = diagnostics
        write_json(state_path, prior)
        return "blocked_waiting_instructions", {"resumed_after_restart": True, "previous_state": prior, "diagnostics": diagnostics, "dpkg_configure": repair, "rollback": "not_performed"}
    if prior and prior.get("status") == "blocked_waiting_instructions":
        return "blocked_waiting_instructions", {"resumed_after_restart": True, "previous_state": prior, "diagnostics": upgrade_diagnostics(), "rollback": "not_performed"}
    completed = []
    write_json(state_path, {"status": "running", "task_id": task_id, "task": task, "steps": completed, "started_at": now()})
    for index, step in enumerate(steps, 1):
        if not isinstance(step, dict) or not isinstance(step.get("command"), str):
            return "rejected", {"error": "neplatný upgrade step"}
        diagnostics = upgrade_diagnostics()
        locks = diagnostics["apt_dpkg"]["apt_locks"].get("output", "")
        if diagnostics["apt_dpkg"]["dpkg_audit"].get("output") or locks:
            write_json(state_path, {"status": "running", "task_id": task_id, "task": task, "steps": completed, "before_step": index, "diagnostics": diagnostics})
            return "blocked_waiting_instructions", {"completed_steps": completed, "failed_step": index, "diagnostics": diagnostics, "rollback": "not_performed"}
        code, output = cmd(step["command"], min(86400, max(1, int(step.get("timeout", 300)))))
        completed.append({"index": index, "name": str(step.get("name", "step-" + str(index))), "exit_code": code, "output": trim(output)})
        write_json(state_path, {"status": "running", "task_id": task_id, "task": task, "steps": completed, "next_step": index + 1, "updated_at": now()})
        if code:
            return "blocked_waiting_instructions", {"completed_steps": completed, "failed_step": index, "diagnostics": upgrade_diagnostics(), "rollback": "not_performed"}
    state_path.unlink(missing_ok=True)
    return "completed", {"completed_steps": completed}


def recover_interrupted_upgrades(repo, conf):
    directory = VAR / "upgrade-state"
    if not directory.exists():
        return 0
    recovered = 0
    for path in sorted(directory.glob("*.json")):
        try:
            prior = json.loads(path.read_text(encoding="utf-8"))
            if prior.get("status") != "running" or not isinstance(prior.get("task"), dict):
                continue
            task_id = str(prior.get("task_id", path.stem))
            leases = acquire_execution_lease(VAR / "leases", task_id)
            if leases is None:
                continue
            with leases[0], leases[1]:
                status, details = execute_upgrade(prior["task"], task_id)
                result(repo, task_id, status, **details)
            deliver_result(conf, repo, task_id, json.loads((repo / "results" / (task_id + ".json")).read_text(encoding="utf-8")))
            recovered += 1
        except Exception as exc:
            print(json.dumps({"time": now(), "status": "upgrade_recovery_failed", "task_id": path.stem, "error": trim(str(exc))}), file=sys.stderr, flush=True)
    return recovered


def execute(repo, path, task, state, signed=False):
    task_id = str(task.get("id", path.stem))
    kind = task.get("type")
    if kind == "ping":
        result(repo, task_id, "ok", message="hello", hostname=socket.gethostname())
        path.unlink(missing_ok=True)
        Path(str(path) + ".sig").unlink(missing_ok=True)
        return False
    elif kind == "cmd":
        code, out = cmd(str(task.get("command", "")), task.get("timeout", 300))
        result(repo, task_id, "ok" if code == 0 else "failed", exit_code=code, output=trim(out))
        path.unlink(missing_ok=True)
        Path(str(path) + ".sig").unlink(missing_ok=True)
        return False
    elif kind == "agent":
        status, details = dispatch_agent(repo, task, state, signed)
        result(repo, task_id, status, **details)
        path.unlink(missing_ok=True)
        Path(str(path) + ".sig").unlink(missing_ok=True)
        return False
    elif kind == "auth" and task.get("provider") == "codex":
        status, details = auth_codex(task)
        result(repo, task_id, status, **details)
        path.unlink(missing_ok=True)
        Path(str(path) + ".sig").unlink(missing_ok=True)
        return False
    elif kind == "upgrade":
        status, details = execute_upgrade(task, task_id)
        result(repo, task_id, status, **details)
        path.unlink(missing_ok=True)
        Path(str(path) + ".sig").unlink(missing_ok=True)
        return False
    elif kind == "watch":
        code, out = cmd(str(task.get("verify", "")), task.get("timeout", 300))
        count = int(state.get(task_id, 0)) + 1 if code == 0 else 0
        state[task_id] = count
        needed = max(1, int(task.get("success_after", 1)))
        if count >= needed:
            result(repo, task_id, "ready_to_retire", consecutive_successes=count, output=trim(out))
            path.unlink(missing_ok=True)
            Path(str(path) + ".sig").unlink(missing_ok=True)
            state.pop(task_id, None)
        else:
            write_json(repo / "results" / (task_id + ".json"), {"id": task_id, "status": "watching", "consecutive_successes": count, "required": needed, "time": now(), "output": trim(out)})
        return False
    elif kind == "retire":
        path.unlink(missing_ok=True)
        Path(str(path) + ".sig").unlink(missing_ok=True)
        uninstall(repo, task_id, {"id": task_id, "status": "retired", "time": now()})
        return True
    else:
        result(repo, task_id, "rejected", reason="neznámý typ úkolu")
        path.unlink(missing_ok=True)
        Path(str(path) + ".sig").unlink(missing_ok=True)
        return False
    return False


def cycle():
    if (ETC / "DISABLED").exists():
        return
    conf = config()
    repo = Path(conf["repo"])
    recover_interrupted_upgrades(repo, conf)
    sync(repo)
    flush_outbox_git(repo)
    conf["last_git_sync"] = now()
    write_json(ETC / "config.json", conf)
    write_json(repo / "hb" / (conf["id"] + ".json"), heartbeat(conf))
    state_path = VAR / "watch-state.json"
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        state = {}
    try:
        push(repo, "guardian: heartbeat " + conf["id"])
    except RuntimeError:
        sync(repo)
        push(repo, "guardian: heartbeat " + conf["id"])
    pending = sorted((repo / "tasks/pending").glob("*.json"))
    for path in pending:
        if not verify(path):
            rejected(repo, path, "podpis chybí nebo není platný")
            rejected_data = json.loads((repo / "results" / (path.stem[:100] + ".json")).read_text(encoding="utf-8"))
            deliver_result(conf, repo, path.stem[:100], rejected_data)
            continue
        try:
            task = json.loads(path.read_text(encoding="utf-8"))
            if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", path.stem) or task.get("id", path.stem) != path.stem:
                raise ValueError("ID úkolu nesouhlasí s názvem souboru")
            if path.stem in state.get("delivery_pending_ids", []):
                result_data = json.loads((repo / "results" / (path.stem + ".json")).read_text(encoding="utf-8"))
                deliver_result(conf, repo, path.stem, result_data)
                continue
            if path.stem in state.get("completed_ids", []):
                path.unlink(missing_ok=True)
                Path(str(path) + ".sig").unlink(missing_ok=True)
                continue
            time_error = task_time_error(task)
            if time_error:
                result(repo, path.stem, "timeout" if time_error == "podepsaný úkol vypršel" else "rejected", reason=time_error)
                path.unlink(missing_ok=True)
                Path(str(path) + ".sig").unlink(missing_ok=True)
                result_data = json.loads((repo / "results" / (path.stem + ".json")).read_text(encoding="utf-8"))
                deliver_result(conf, repo, path.stem, result_data)
                continue
            leases = acquire_execution_lease(VAR / "leases", path.stem)
            if leases is None:
                continue
            with leases[0], leases[1]:
                try:
                    state = json.loads(state_path.read_text(encoding="utf-8"))
                except (OSError, json.JSONDecodeError):
                    state = {}
                if path.stem in state.get("completed_ids", []):
                    continue
                retired = execute(repo, path, task, state, signed=True)
                write_json(state_path, state)
            if retired:
                final_path = repo / "results" / ("final-" + path.stem + ".json")
                if final_path.exists():
                    deliver_result(conf, repo, path.stem, json.loads(final_path.read_text(encoding="utf-8")))
                return
            result_data = json.loads((repo / "results" / (path.stem + ".json")).read_text(encoding="utf-8"))
            deliver_result(config(), repo, path.stem, result_data)
        except Exception as e:
            failure = result(repo, path.stem, "failed", error=trim(str(e)))
            path.unlink(missing_ok=True)
            Path(str(path) + ".sig").unlink(missing_ok=True)
            deliver_result(conf, repo, path.stem, failure)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--once":
        cycle()
        return
    delay = 0
    fails = 0
    last_relay = 0
    outage_since = None
    relay_mode = True
    while True:
        if delay:
            sleep_delay(delay)
        conf = {}
        try:
            conf = config()
            if conf.get("relay_url") and (relay_mode or relay_retry_due(last_relay, time.monotonic())):
                try:
                    relay_loop_once(conf)
                    relay_mode, outage_since = relay_recovered()
                    last_relay = time.monotonic()
                except Exception:
                    relay_mode, outage_since = relay_failed(relay_mode, outage_since, time.monotonic())
                    last_relay = time.monotonic()
            if not relay_mode or not conf.get("relay_url"):
                cycle()
            fails = 0
            delay = max(30, int(120 * random.uniform(1, 1.1667))) if not relay_mode else random.uniform(0.5, 3)
        except Exception as e:
            fails += 1
            if conf.get("relay_url") and relay_mode:
                delay = reconnect_delay(fails - 1)
                if outage_since is not None and fallback_active(time.monotonic() - outage_since):
                    relay_mode, outage_since = relay_failed(relay_mode, outage_since, time.monotonic())
            else:
                delay = min(10800, (900, 3600, 10800)[min(fails - 1, 2)])
            print(json.dumps({"time": now(), "status": "offline", "error": trim(str(e))}), file=sys.stderr, flush=True)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
